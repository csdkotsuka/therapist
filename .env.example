# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe Connect Configuration (Optional for mock mode)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Map Configuration (Google Maps or Mapbox)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Configuration (for Customer Auth & Firestore Data)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# LINE Official Account & LIFF Configuration
# LIFF ID (例: 1234567890-abcdefgh)
NEXT_PUBLIC_LIFF_ID=
# LINE Login Channel ID
NEXT_PUBLIC_LINE_CHANNEL_ID=
# LINE Login Channel Secret
LINE_CHANNEL_SECRET=
# LINE Messaging API Channel Access Token (長期)
LINE_CHANNEL_ACCESS_TOKEN=
