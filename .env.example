# ========================================================
# CareKuru 環境変数テンプレート（.env.local にコピーして値を設定）
#   NEXT_PUBLIC_ で始まる値はブラウザにも配信される。秘密情報には付けないこと。
# ========================================================

# --- 公開 URL（Stripe / LINE のリダイレクト先。本番では必ず設定） ---
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# サーバー専用（LINE ログイン・審査の承認/差戻し・Stripe Webhook で使用）。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=

# --- LINE ログイン（LINE Developers の LINE Login チャネル） ---
NEXT_PUBLIC_LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# LINE アプリ内（LIFF）で開いたときの自動ログイン用（任意）
NEXT_PUBLIC_LIFF_ID=
# Messaging API（通知送信用・任意）
LINE_CHANNEL_ACCESS_TOKEN=

# --- Google Maps / Routes API ---
# ブラウザ用（必ず HTTP リファラ制限を設定）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# サーバー用（/api/routes で使用。IP 制限などを設定）。未設定ならブラウザ用キーを使う
GOOGLE_MAPS_SERVER_API_KEY=

# --- Stripe（platform_settings.payment_mode を 'stripe' にしたときに使用） ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
